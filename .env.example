# Copy this file to .env and fill in real values. Never commit .env.

# Anthropic API key (console.anthropic.com)
ANTHROPIC_API_KEY=

# The mailbox that deal submissions are forwarded to (the one your
# underwriters currently monitor).
EMAIL_ADDRESS=uw@yourcompany.com
# For Gmail/Google Workspace: create an App Password (requires 2FA) and use it here.
# For Microsoft 365: use an app password or SMTP/IMAP-enabled account credentials.
EMAIL_PASSWORD=

# Gmail defaults below. Microsoft 365: outlook.office365.com / smtp.office365.com (port 587).
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# Mailbox folder to watch and how often to check it (seconds).
IMAP_FOLDER=INBOX
POLL_SECONDS=60

# Optional: only process emails whose subject contains this text (case-insensitive).
# Leave blank to process every email that arrives with PDF/image attachments.
SUBJECT_FILTER=

# true = analyze but DO NOT send email replies (prints the analysis instead).
# Run with DRY_RUN=true first to check output quality before going live.
DRY_RUN=true

# Model used for the analysis.
CLAUDE_MODEL=claude-opus-5

# Where processed-message tracking is stored.
DB_PATH=data/processed.db
